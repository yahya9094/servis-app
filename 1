<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="gold">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#090d16">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>سرویس من | حسابدار هوشمند</title>
  
  <!-- آیکون اختصاصی اپلیکیشن برای Add to Home Screen -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Crect width='512' height='512' rx='115' fill='%230f172a'/%3E%3Ccircle cx='256' cy='256' r='190' fill='%23eab308' opacity='0.15'/%3E%3Cpath d='M120 290l32-95c8-24 30-40 55-40h98c25 0 47 16 55 40l32 95v75c0 14-11 25-25 25h-20c-14 0-25-11-25-25v-15H190v15c0 14-11 25-25 25h-20c-14 0-25-11-25-25v-75zm55-20h162l-20-60c-4-12-15-20-28-20h-66c-13 0-24 8-28 20l-20 60zm-5 50a20 20 0 1 0 0-40 20 20 0 0 0 0 40zm172 0a20 20 0 1 0 0-40 20 20 0 0 0 0 40z' fill='%23eab308'/%3E%3C/svg%3E">
  <link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Crect width='512' height='512' rx='115' fill='%230f172a'/%3E%3Cpath d='M120 290l32-95c8-24 30-40 55-40h98c25 0 47 16 55 40l32 95v75c0 14-11 25-25 25h-20c-14 0-25-11-25-25v-15H190v15c0 14-11 25-25 25h-20c-14 0-25-11-25-25v-75zm55-20h162l-20-60c-4-12-15-20-28-20h-66c-13 0-24 8-28 20l-20 60zm-5 50a20 20 0 1 0 0-40 20 20 0 0 0 0 40zm172 0a20 20 0 1 0 0-40 20 20 0 0 0 0 40z' fill='%23eab308'/%3E%3C/svg%3E">

  <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    /* تم‌های رنگی متنوع */
    :root, [data-theme="gold"] {
      --bg: #090d16;
      --bg-grad: radial-gradient(circle at top right, #1e293b 0%, #090d16 65%);
      --card: rgba(22, 30, 49, 0.92);
      --nav-bg: rgba(13, 19, 33, 0.96);
      --input-bg: rgba(15, 23, 42, 0.9);
      --border: rgba(255, 255, 255, 0.1);
      --primary: #eab308;
      --primary-text: #000000;
      --text: #f8fafc;
      --muted: #94a3b8;
      --danger: #ef4444;
      --success: #22c55e;
    }
    [data-theme="ocean"] {
      --bg: #06121e;
      --bg-grad: radial-gradient(circle at top left, #0c4a6e 0%, #06121e 65%);
      --card: rgba(12, 32, 52, 0.92);
      --nav-bg: rgba(8, 22, 36, 0.96);
      --input-bg: rgba(7, 24, 40, 0.9);
      --border: rgba(56, 189, 248, 0.16);
      --primary: #38bdf8;
      --primary-text: #000000;
      --text: #f0f9ff;
      --muted: #7dd3fc;
      --danger: #fb7185;
      --success: #34d399;
    }
    [data-theme="emerald"] {
      --bg: #051410;
      --bg-grad: radial-gradient(circle at top right, #064e3b 0%, #051410 65%);
      --card: rgba(10, 36, 29, 0.92);
      --nav-bg: rgba(6, 24, 19, 0.96);
      --input-bg: rgba(6, 28, 22, 0.9);
      --border: rgba(52, 211, 153, 0.16);
      --primary: #10b981;
      --primary-text: #000000;
      --text: #ecfdf5;
      --muted: #6ee7b7;
      --danger: #f87171;
      --success: #34d399;
    }
    [data-theme="light"] {
      --bg: #f1f5f9;
      --bg-grad: linear-gradient(180deg, #e2e8f0 0%, #f8fafc 100%);
      --card: rgba(255, 255, 255, 0.95);
      --nav-bg: rgba(255, 255, 255, 0.98);
      --input-bg: #f8fafc;
      --border: rgba(15, 23, 42, 0.12);
      --primary: #2563eb;
      --primary-text: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --danger: #dc2626;
      --success: #16a34a;
    }

    * { box-sizing: border-box; font-family: 'Vazirmatn', sans-serif; -webkit-tap-highlight-color: transparent; }
    html, body {
      margin: 0; padding: 0; background: var(--bg); color: var(--text);
      overflow-x: hidden; overscroll-behavior-y: none;
    }
    body {
      padding: 14px 14px 86px 14px;
      background-image: var(--bg-grad); background-attachment: fixed;
      min-height: 100dvh; transition: background 0.3s, color 0.3s;
    }
    .container { max-width: 540px; margin: 0 auto; }
    
    header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid var(--border);
    }
    h1 { font-size: 1.15rem; margin: 0; color: var(--primary); display: flex; align-items: center; gap: 8px; }
    .sync-badge {
      font-size: 0.72rem; padding: 4px 10px; border-radius: 20px;
      background: rgba(34, 197, 94, 0.15); color: var(--success); border: 1px solid rgba(34, 197, 94, 0.3);
    }

    /* منوی ناوبری پایین صفحه مخصوص موبایل */
    .bottom-nav {
      position: fixed; bottom: 0; left: 0; right: 0;
      background: var(--nav-bg); backdrop-filter: blur(14px);
      border-top: 1px solid var(--border);
      display: flex; justify-content: space-around; align-items: center;
      padding: 8px 6px calc(8px + env(safe-area-inset-bottom)); z-index: 900;
    }
    .nav-item {
      flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px;
      background: transparent; border: none; color: var(--muted);
      font-size: 0.75rem; font-weight: 600; cursor: pointer; padding: 4px 0; transition: 0.2s;
    }
    .nav-item .nav-icon { font-size: 1.25rem; line-height: 1; }
    .nav-item.active { color: var(--primary); transform: translateY(-2px); }

    .card {
      background: var(--card); backdrop-filter: blur(12px); border: 1px solid var(--border);
      border-radius: 20px; padding: 16px; margin-bottom: 14px; box-shadow: 0 8px 24px rgba(0,0,0,0.18);
    }
    .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; gap: 8px; }
    .card-title { font-size: 0.96rem; font-weight: 700; margin: 0; }
    .helper-tip {
      background: rgba(234, 179, 8, 0.1); border: 1px dashed var(--primary);
      border-radius: 12px; padding: 10px 12px; font-size: 0.8rem; color: var(--text);
      margin-bottom: 12px; line-height: 1.6;
    }

    /* کارت‌های تایید امروز */
    .today-item {
      display: flex; flex-direction: column; gap: 10px;
      background: rgba(128,128,128,0.05); border: 1px solid var(--border);
      padding: 13px; border-radius: 16px; margin-bottom: 10px; transition: 0.2s;
    }
    .today-item.done { border-color: rgba(34, 197, 94, 0.45); background: rgba(34, 197, 94, 0.08); }
    .today-item.absent { border-color: rgba(239, 68, 68, 0.4); background: rgba(239, 68, 68, 0.07); }
    .today-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .green-dot {
      display: inline-block; width: 11px; height: 11px; border-radius: 50%;
      background: #22c55e; box-shadow: 0 0 8px #22c55e; margin-left: 7px; vertical-align: middle;
    }
    .btn-settle-item {
      background: rgba(34, 197, 94, 0.14); color: var(--success); border: 1px solid rgba(34, 197, 94, 0.35);
      padding: 5px 9px; border-radius: 8px; cursor: pointer; font-size: 0.74rem; font-weight: 700;
    }
    .settled-tag {
      font-size: 0.72rem; color: var(--success); background: rgba(34, 197, 94, 0.1);
      padding: 3px 8px; border-radius: 7px; border: 1px solid rgba(34, 197, 94, 0.25);
    }
    .today-actions { display: flex; gap: 8px; }
    .today-actions button { flex: 1; justify-content: center; }

    .btn-confirm {
      background: var(--primary); color: var(--primary-text); border: none; padding: 10px 12px;
      border-radius: 11px; font-weight: 700; font-size: 0.84rem; cursor: pointer;
      display: flex; align-items: center; gap: 5px;
    }
    .btn-absent {
      background: rgba(239, 68, 68, 0.14); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.35);
      padding: 10px 12px; border-radius: 11px; font-weight: 700; font-size: 0.84rem; cursor: pointer;
      display: flex; align-items: center; gap: 5px;
    }
    .btn-status-badge {
      width: 100%; padding: 9px 12px; border-radius: 11px; font-weight: 700; font-size: 0.82rem;
      cursor: pointer; border: 1px solid var(--border); background: rgba(128,128,128,0.08); color: var(--text);
    }

    /* ورودی‌ها و دکمه‌ها */
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px; }
    input, select {
      width: 100%; padding: 11px 12px; border-radius: 12px; border: 1px solid var(--border);
      background: var(--input-bg); color: var(--text); font-size: 0.9rem; outline: none;
    }
    input:focus, select:focus { border-color: var(--primary); }
    .btn-primary {
      width: 100%; padding: 13px; border: none; border-radius: 13px;
      background: var(--primary); color: var(--primary-text); font-weight: 700; font-size: 0.92rem;
      cursor: pointer; margin-top: 8px; transition: 0.15s;
    }
    .btn-primary:active, .btn-confirm:active, .btn-absent:active { transform: scale(0.97); }
    .btn-secondary {
      padding: 9px 12px; border: 1px solid var(--border); border-radius: 11px;
      background: rgba(128,128,128,0.08); color: var(--text); font-size: 0.82rem; cursor: pointer;
    }

    /* دکمه‌های انتخاب چندگانه افراد و روزها */
    .pills-wrap { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 12px; }
    .pill-btn {
      padding: 8px 13px; border-radius: 11px; border: 1px solid var(--border);
      background: rgba(128,128,128,0.06); color: var(--text); font-size: 0.84rem;
      cursor: pointer; transition: 0.15s; font-weight: 500;
    }
    .pill-btn.active {
      background: var(--primary); border-color: var(--primary);
      color: var(--primary-text); font-weight: 700;
    }

    /* پوشه‌های افراد در برنامه هفته */
    .folder-card {
      border: 1px solid var(--border); border-radius: 15px; margin-bottom: 10px;
      overflow: hidden; background: rgba(128,128,128,0.04);
    }
    .folder-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 13px 14px; cursor: pointer; font-weight: 700; font-size: 0.92rem;
    }
    .folder-body { padding: 0 14px 12px; border-top: 1px solid var(--border); }

    /* آمار و گزارش */
    .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }
    .stat-box { background: rgba(128,128,128,0.06); padding: 12px; border-radius: 15px; border: 1px solid var(--border); }
    .stat-label { font-size: 0.76rem; color: var(--muted); display: block; margin-bottom: 4px; }
    .stat-val { font-size: 1.05rem; font-weight: 700; color: var(--primary); }
    
    .log-item {
      display: flex; justify-content: space-between; align-items: center;
      padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 0.84rem;
    }
    .log-item:last-child { border-bottom: none; }
    .del-btn {
      background: rgba(239, 68, 68, 0.15); color: var(--danger); border: none;
      padding: 6px 10px; border-radius: 8px; cursor: pointer; font-size: 0.76rem; font-weight: 600;
    }
    .hidden { display: none !important; }
    
    .toast {
      position: fixed; top: 18px; left: 50%; transform: translateX(-50%);
      background: var(--primary); color: var(--primary-text); padding: 10px 20px; border-radius: 30px;
      font-weight: 700; font-size: 0.84rem; box-shadow: 0 6px 20px rgba(0,0,0,0.4);
      opacity: 0; pointer-events: none; transition: 0.3s; z-index: 1100; white-space: nowrap;
    }
    .toast.show { opacity: 1; top: 26px; }
    .modal-backdrop {
      position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(4px);
      display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 20px;
    }
    .modal-box {
      background: var(--card); border: 1px solid var(--border); border-radius: 20px;
      padding: 20px; max-width: 360px; width: 100%; text-align: center;
    }
  </style>
</head>
<body>
<div class="container">
  <header>
    <h1>🚖 سرویس من</h1>
    <span class="sync-badge" id="syncStatus">● آنلاین و هماهنگ</span>
  </header>

  <!-- تب ۱: خانه (تایید روزانه + مسیر اضافه) -->
  <div id="tab-today">
    <div class="card">
      <div class="card-header">
        <span class="card-title">📋 برنامه سرویس امروز</span>
        <input type="date" id="selectedDate" style="width:auto; padding:6px 10px; font-size:0.8rem;" onchange="renderAll()">
      </div>
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <span id="todayDayLabel" style="font-size:0.84rem; color:var(--primary); font-weight:700;"></span>
        <button id="confirmAllBtn" class="btn-secondary hidden" style="border-color:var(--primary); color:var(--primary); font-weight:700;" onclick="confirmAllToday()">⚡ تایید همه برنامه‌های امروز</button>
      </div>
      <div id="todayChecklist">در حال دریافت برنامه...</div>
    </div>

    <div class="card">
      <div class="card-header">
        <span class="card-title">➕ ثبت مسیر یا کلاس اضافه</span>
      </div>
      <div style="font-size:0.78rem; color:var(--muted); margin-bottom:6px;">چه کسانی رفتند؟ (انتخاب چند نفر = ثبت به عنوان یک کلاس مشترک):</div>
      <div class="pills-wrap" id="extraPersonPills"></div>

      <div class="grid-2">
        <input type="text" id="extraTitle" placeholder="نام مسیر (مثلاً: کلاس جبرانی)">
        <input type="text" inputmode="numeric" id="extraPrice" placeholder="مبلغ (مثلاً: 50,000)" oninput="formatPriceInput(this)">
      </div>
      <button class="btn-primary" onclick="addExtraTrip()">ثبت مسیر اضافه</button>
    </div>
  </div>

  <!-- تب ۲: برنامه هفته + پوشه افراد -->
  <div id="tab-schedule" class="hidden">
    <div class="card">
      <div class="card-title" style="margin-bottom:8px;">📅 تعریف برنامه ثابت هفتگی</div>
      <div class="helper-tip">
        💡 <strong>راهنما:</strong> روزهای کلاس، افراد و مبلغ را انتخاب کنید تا از این به بعد هر روز در صفحه اول آماده تایید باشد.
      </div>

      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
        <span style="font-size:0.78rem; color:var(--muted);">۱. انتخاب روزهای هفته:</span>
        <button class="btn-secondary" style="padding:4px 8px; font-size:0.72rem;" onclick="selectWeekdays()">شنبه تا چهارشنبه</button>
      </div>
      <div class="pills-wrap" id="dayPills"></div>

      <div style="font-size:0.78rem; color:var(--muted); margin-bottom:6px;">۲. انتخاب افراد (تکی یا چند نفر هم‌زمان برای کلاس دوتایی):</div>
      <div class="pills-wrap" id="schedPersonPills"></div>

      <div class="grid-2">
        <input type="text" id="schedTitle" placeholder="عنوان (مثلاً: رفت و برگشت مدرسه)">
        <input type="text" inputmode="numeric" id="schedPrice" placeholder="مبلغ (مثلاً: 60,000)" oninput="formatPriceInput(this)">
      </div>
      <button class="btn-primary" onclick="addScheduleItem()">➕ ذخیره در برنامه هفته</button>
    </div>

    <!-- پوشه‌های برنامه‌های هر فرد -->
    <div class="card">
      <div class="card-title" style="margin-bottom:10px;">📁 پوشه برنامه‌های هفتگی</div>
      <p style="font-size:0.76rem; color:var(--muted); margin-top:0;">کلاس‌های تکی در پوشه هر فرد و کلاس‌های دوتایی/مشترک در پوشه جداگانه قرار دارند:</p>
      <div id="personFolders"></div>
    </div>
  </div>

  <!-- تب ۳: گزارش مالی، حضور و غیاب و تسویه حساب -->
  <div id="tab-report" class="hidden">
    <div class="card">
      <div class="card-header">
        <span class="card-title">💰 وضعیت حساب و کرایه‌ها</span>
        <button class="btn-secondary" style="border-color:var(--success); color:var(--success); font-weight:700;" onclick="settleAccount()">🤝 تسویه حساب شد</button>
      </div>

      <div class="stats-grid">
        <div class="stat-box">
          <span class="stat-label">بدهی فعلی (از آخرین تسویه)</span>
          <span class="stat-val" id="unsettledTotal">۰ تومان</span>
        </div>
        <div class="stat-box">
          <span class="stat-label">جمع ۳۰ روز اخیر</span>
          <span class="stat-val" id="monthTotal">۰ تومان</span>
        </div>
      </div>

      <div class="card-title" style="margin:14px 0 8px;">جزئیات سهم، حضور و غیبت هر نفر (از آخرین تسویه)</div>
      <div id="personBreakdown"></div>

      <button class="btn-secondary" style="width:100%; margin-top:10px;" onclick="copyReport()">📋 کپی صورت‌حساب برای ارسال در پیام‌رسان</button>
    </div>

    <div class="card">
      <div class="card-header">
        <span class="card-title">تاریخچه ترددها</span>
        <select id="filterPerson" style="width:auto; padding:6px 10px;" onchange="renderAll()">
          <option value="ALL">همه افراد</option>
        </select>
      </div>
      <div id="fullLogs"></div>
    </div>
  </div>

  <!-- تب ۴: تنظیمات (تم‌ها و مدیریت افراد) -->
  <div id="tab-settings" class="hidden">
    <div class="card">
      <div class="card-title" style="margin-bottom:10px;">🎨 انتخاب تم ظاهری برنامه</div>
      <div class="grid-2">
        <button class="btn-secondary" onclick="setTheme('gold')">🌙 طلایی تیره (پیش‌فرض)</button>
        <button class="btn-secondary" onclick="setTheme('ocean')">🌊 آبی اقیانوسی</button>
        <button class="btn-secondary" onclick="setTheme('emerald')">🌲 سبز زمردی</button>
        <button class="btn-secondary" onclick="setTheme('light')">☀️ روز روشن</button>
      </div>
    </div>

    <div class="card">
      <div class="card-title" style="margin-bottom:10px;">👥 مدیریت افراد سرویس</div>
      <div style="display:flex; gap:8px;">
        <input type="text" id="newPersonName" placeholder="نام فرد جدید (مثلاً: خواهرم)">
        <button class="btn-primary" style="width:auto; margin:0; padding:0 18px;" onclick="addPerson()">افزودن</button>
      </div>
      <div id="peopleManageList" style="margin-top:14px;"></div>
    </div>

    <div class="card">
      <div class="card-title" style="margin-bottom:6px;">📲 نصب شبیه اپلیکیشن روی گوشی</div>
      <p style="font-size:0.8rem; color:var(--muted); margin:0; line-height:1.7;">
        در مرورگر گوشی روی دکمه منو (سه نقطه بالا یا دکمه Share در آیفون) بزنید و گزینه <strong>Add to Home Screen</strong> را انتخاب کنید تا با آیکون اختصاصی روی صفحه گوشی نصب شود.
      </p>
    </div>
  </div>
</div>

<!-- منوی پایین صفحه -->
<nav class="bottom-nav">
  <button class="nav-item active" onclick="switchTab('today')">
    <span class="nav-icon">✅</span>
    <span>تایید امروز</span>
  </button>
  <button class="nav-item" onclick="switchTab('schedule')">
    <span class="nav-icon">📅</span>
    <span>برنامه هفته</span>
  </button>
  <button class="nav-item" onclick="switchTab('report')">
    <span class="nav-icon">📊</span>
    <span>گزارش مالی</span>
  </button>
  <button class="nav-item" onclick="switchTab('settings')">
    <span class="nav-icon">⚙️</span>
    <span>تنظیمات</span>
  </button>
</nav>

<!-- پنجره تایید سفارشی -->
<div id="confirmModal" class="modal-backdrop hidden">
  <div class="modal-box">
    <div id="confirmText" style="margin-bottom:16px; font-size:0.92rem; line-height:1.6;">آیا مطمئن هستید؟</div>
    <div style="display:flex; gap:10px; justify-content:center;">
      <button class="btn-primary" style="margin:0;" id="confirmYesBtn">بله، انجام شود</button>
      <button class="btn-secondary" onclick="closeModal()">انصراف</button>
    </div>
  </div>
</div>

<div class="toast" id="toast">انجام شد!</div>

<script>
  const SUPABASE_URL = 'https://ukofnemxqnuafpothvwt.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_7IxhricsaC6edJLEVix2aw_nons58ji';
  const db = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

  const DAYS = [
    { id: 6, name: 'شنبه' },
    { id: 0, name: 'یکشنبه' },
    { id: 1, name: 'دوشنبه' },
    { id: 2, name: 'سه‌شنبه' },
    { id: 3, name: 'چهارشنبه' },
    { id: 4, name: 'پنج‌شنبه' },
    { id: 5, name: 'جمعه' }
  ];

  let state = {
    people: [],
    schedule: [],
    trips: [],
    selectedSchedDays: [new Date().getDay()],
    selectedExtraPeople: [],
    selectedSchedPeople: [],
    openFolders: {}
  };

  // بارگذاری تم ذخیره‌شده
  const savedTheme = localStorage.getItem('service_theme') || 'gold';
  document.documentElement.setAttribute('data-theme', savedTheme);

  function setTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('service_theme', theme);
    showToast('🎨 تم تغییر کرد');
  }

  const dateInput = document.getElementById('selectedDate');
  dateInput.valueAsDate = new Date();

  function parseRawNumber(str) {
    if (!str) return 0;
    const en = String(str)
      .replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d))
      .replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d))
      .replace(/[^\d]/g, '');
    return Number(en) || 0;
  }

  function formatPriceInput(el) {
    const num = parseRawNumber(el.value);
    el.value = num > 0 ? num.toLocaleString('en-US') : '';
  }

  function toggleMultiSelect(arr, val) {
    const idx = arr.indexOf(val);
    if (idx > -1) {
      if (arr.length > 1) arr.splice(idx, 1);
      else showToast('حداقل یک گزینه باید انتخاب باشد');
    } else {
      arr.push(val);
    }
    renderAll();
  }

  function selectWeekdays() {
    state.selectedSchedDays = [6, 0, 1, 2, 3];
    renderAll();
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2400);
  }

  let pendingConfirmAction = null;
  function askConfirm(text, onYes) {
    document.getElementById('confirmText').textContent = text;
    pendingConfirmAction = onYes;
    document.getElementById('confirmModal').classList.remove('hidden');
  }
  function closeModal() {
    document.getElementById('confirmModal').classList.add('hidden');
    pendingConfirmAction = null;
  }
  document.getElementById('confirmYesBtn').onclick = () => {
    if (pendingConfirmAction) pendingConfirmAction();
    closeModal();
  };

  function formatMoney(num) {
    return Number(num || 0).toLocaleString('fa-IR') + ' تومان';
  }

  function toPersianDate(dateStr) {
    try { return new Date(dateStr).toLocaleDateString('fa-IR'); } catch { return dateStr; }
  }

  function switchTab(tab) {
    ['today', 'schedule', 'report', 'settings'].forEach(t => {
      document.getElementById('tab-' + t).classList.toggle('hidden', t !== tab);
    });
    document.querySelectorAll('.nav-item').forEach((btn, idx) => {
      btn.classList.toggle('active', ['today', 'schedule', 'report', 'settings'][idx] === tab);
    });
  }

  async function loadData() {
    try {
      const [pRes, sRes, tRes] = await Promise.all([
        db.from('people').select('*').order('id'),
        db.from('weekly_schedule').select('*').order('id'),
        db.from('trips').select('*').order('trip_date', { ascending: false }).order('id', { ascending: false })
      ]);

      if (pRes.data && pRes.data.length > 0) {
        state.people = pRes.data;
      } else if (pRes.data && pRes.data.length === 0) {
        state.people = [];
      } else if (state.people.length === 0) {
        state.people = [{ id: 1, name: 'یحیی' }, { id: 2, name: 'خواهرم' }];
      }

      if (sRes.data) state.schedule = sRes.data;
      if (tRes.data) state.trips = tRes.data;

      const validNames = state.people.map(p => p.name);
      state.selectedExtraPeople = state.selectedExtraPeople.filter(n => validNames.includes(n));
      state.selectedSchedPeople = state.selectedSchedPeople.filter(n => validNames.includes(n));

      if (state.selectedExtraPeople.length === 0 && state.people.length > 0) {
        state.selectedExtraPeople = [state.people[0].name];
      }
      if (state.selectedSchedPeople.length === 0 && state.people.length > 0) {
        state.selectedSchedPeople = [state.people[0].name];
      }
    } catch (e) {
      console.error(e);
    }
    renderAll();
  }

  // همگام‌سازی لحظه‌ای بین گوشی شما و خواهرتان
  function initRealtime() {
    let canUseWS = false;
    try {
      const testUrl = SUPABASE_URL.replace('https://', 'wss://') + '/realtime/v1/websocket?apikey=' + SUPABASE_KEY + '&vsn=1.0.0';
      const ws = new WebSocket(testUrl);
      ws.close();
      canUseWS = true;
    } catch (e) {
      canUseWS = false;
    }

    if (canUseWS) {
      db.channel('service-sync')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'trips' }, loadData)
        .on('postgres_changes', { event: '*', schema: 'public', table: 'weekly_schedule' }, loadData)
        .on('postgres_changes', { event: '*', schema: 'public', table: 'people' }, loadData)
        .subscribe();
    } else {
      setInterval(loadData, 4000);
    }
  }
  initRealtime();

  // تایید انجام یا ثبت «نرفتم» برای برنامه روزانه (تکی یا گروهی با یک تایید)
  async function recordTodayStatus(item, isPresent) {
    const trip_date = dateInput.value;
    const { error } = await db.from('trips').insert([{
      person: item.person,
      trip_type: isPresent ? item.title : `${item.title} (نرفتم)`,
      amount: isPresent ? item.price : 0,
      trip_date: trip_date
    }]);
    if (!error) {
      showToast(isPresent ? `🟢 تایید شد: ${item.person}` : `🟢 ثبت شد (نرفتم): ${item.person}`);
      loadData();
    } else {
      showToast('خطا: ' + error.message);
    }
  }

  // تایید یک‌جای تمام برنامه‌های تاییدنشده امروز
  async function confirmAllToday() {
    const selDateStr = dateInput.value;
    const dayOfWeek = new Date(selDateStr + 'T12:00:00').getDay();
    const activePeopleNames = state.people.map(p => p.name);
    const todaysPlanned = state.schedule.filter(s => s.day_of_week === dayOfWeek && isScheduleValidForActivePeople(s, activePeopleNames));
    const todaysConfirmed = state.trips.filter(t => t.trip_date === selDateStr);

    const remaining = todaysPlanned.filter(item =>
      !todaysConfirmed.some(t => t.person === item.person && t.trip_type.startsWith(item.title))
    );
    if (remaining.length === 0) return;

    const rows = remaining.map(item => ({
      person: item.person,
      trip_type: item.title,
      amount: item.price,
      trip_date: selDateStr
    }));

    const { error } = await db.from('trips').insert(rows);
    if (!error) {
      showToast(`⚡ ${rows.length} برنامه امروز یک‌جا تایید شد!`);
      loadData();
    }
  }

  function unconfirmTrip(tripId) {
    askConfirm('آیا مطمئن هستید که می‌خواهید وضعیت این کلاس را لغو کنید؟', async () => {
      await db.from('trips').delete().eq('id', tripId);
      showToast('وضعیت لغو شد');
      loadData();
    });
  }

  // ثبت مسیر اضافه (تکی یا گروهی بدون تقسیم قیمت)
  async function addExtraTrip() {
    const people = state.selectedExtraPeople;
    const trip_type = document.getElementById('extraTitle').value.trim();
    const rawAmount = parseRawNumber(document.getElementById('extraPrice').value);
    const trip_date = dateInput.value;

    if (people.length === 0) return showToast('حداقل یک نفر را انتخاب کنید');
    if (!trip_type || !rawAmount) return showToast('عنوان مسیر و مبلغ را وارد کنید');

    const personLabel = people.join(' و ');
    const { error } = await db.from('trips').insert([{
      person: personLabel,
      trip_type: people.length > 1 ? `${trip_type} (مشترک)` : trip_type,
      amount: rawAmount,
      trip_date
    }]);

    if (!error) {
      document.getElementById('extraTitle').value = '';
      document.getElementById('extraPrice').value = '';
      showToast(`🟢 مسیر برای «${personLabel}» ثبت شد`);
      loadData();
    } else {
      showToast('خطا: ' + error.message);
    }
  }

  // ثبت برنامه ثابت هفتگی (چند روز هم‌زمان + کلاس دوتایی/مشترک در یک ردیف بدون تقسیم)
  async function addScheduleItem() {
    const people = state.selectedSchedPeople;
    const title = document.getElementById('schedTitle').value.trim();
    const rawPrice = parseRawNumber(document.getElementById('schedPrice').value);

    if (people.length === 0) return showToast('حداقل یک نفر را انتخاب کنید');
    if (!title || !rawPrice) return showToast('عنوان و مبلغ را وارد کنید');

    const personLabel = people.join(' و ');
    const rows = state.selectedSchedDays.map(dayId => ({
      day_of_week: dayId,
      person: personLabel,
      title,
      price: rawPrice
    }));

    const { error } = await db.from('weekly_schedule').insert(rows);
    if (!error) {
      document.getElementById('schedTitle').value = '';
      document.getElementById('schedPrice').value = '';
      showToast(`📅 برنامه برای «${personLabel}» ذخیره شد`);
      loadData();
    } else {
      showToast('خطا: ' + error.message);
    }
  }

  // تسویه تکی برای هر رفت‌وآمد
  function settleSingleTrip(trip) {
    askConfirm(`آیا مطمئن هستید که کرایه «${trip.person} - ${trip.trip_type.replace(' (نرفتم)', '')}» تسویه شد؟`, async () => {
      const cleanType = trip.trip_type.includes('[تسویه شده]') ? trip.trip_type : `${trip.trip_type} [تسویه شده]`;
      const { error } = await db.from('trips').update({ trip_type: cleanType }).eq('id', trip.id);
      if (!error) {
        showToast('🤝 این رفت‌وآمد تسویه شد');
        loadData();
      }
    });
  }

  function isScheduleValidForActivePeople(schedItem, activeNames) {
    const members = schedItem.person.split(' و ').map(s => s.trim());
    return members.every(m => activeNames.includes(m));
  }

  // تسویه حساب کامل با راننده
  function settleAccount() {
    askConfirm('آیا مطمئن هستید که کل حساب با راننده تسویه شده است؟', async () => {
      const today = new Date().toISOString().split('T')[0];
      const { error } = await db.from('trips').insert([{
        person: 'سیستم',
        trip_type: '🤝 تسویه حساب کامل انجام شد',
        amount: 0,
        trip_date: today
      }]);
      if (!error) {
        showToast('🤝 تسویه حساب ثبت شد و حساب صفر شد!');
        loadData();
      }
    });
  }

  function deleteScheduleItem(id) {
    askConfirm('آیا مطمئن هستید که می‌خواهید این مورد را از برنامه هفته حذف کنید؟', async () => {
      await db.from('weekly_schedule').delete().eq('id', id);
      showToast('حذف شد');
      loadData();
    });
  }

  function deleteTripRecord(id) {
    askConfirm('آیا مطمئن هستید که می‌خواهید این رکورد را برای همیشه حذف کنید؟', async () => {
      await db.from('trips').delete().eq('id', id);
      showToast('حذف شد');
      loadData();
    });
  }

  async function addPerson() {
    const name = document.getElementById('newPersonName').value.trim();
    if (!name) return;
    await db.from('people').insert([{ name }]);
    document.getElementById('newPersonName').value = '';
    showToast('فرد جدید اضافه شد');
    loadData();
  }

  function deletePerson(id, name) {
    askConfirm(`آیا مطمئن هستید که می‌خواهید «${name}» و برنامه‌های هفتگی او را حذف کنید؟`, async () => {
      await db.from('people').delete().eq('id', id);
      const relatedSchedules = state.schedule.filter(s => s.person.split(' و ').map(x => x.trim()).includes(name));
      for (const item of relatedSchedules) {
        await db.from('weekly_schedule').delete().eq('id', item.id);
      }
      showToast(`«${name}» حذف شد`);
      loadData();
    });
  }

  function toggleFolder(key) {
    state.openFolders[key] = !state.openFolders[key];
    renderAll();
  }

  function renderAll() {
    // دکمه‌های چند انتخابی افراد در تب امروز
    document.getElementById('extraPersonPills').innerHTML = state.people.map(p => {
      const active = state.selectedExtraPeople.includes(p.name);
      return `<button type="button" class="pill-btn ${active ? 'active' : ''}" onclick="toggleMultiSelect(state.selectedExtraPeople, '${p.name}')">${active ? '✓ ' : '👤 '}${p.name}</button>`;
    }).join('');

    // دکمه‌های چند انتخابی افراد در تب برنامه هفته
    document.getElementById('schedPersonPills').innerHTML = state.people.map(p => {
      const active = state.selectedSchedPeople.includes(p.name);
      return `<button type="button" class="pill-btn ${active ? 'active' : ''}" onclick="toggleMultiSelect(state.selectedSchedPeople, '${p.name}')">${active ? '✓ ' : '👤 '}${p.name}</button>`;
    }).join('');

    // 1. رندر تب «تایید امروز»
    const selDateStr = dateInput.value;
    const dayOfWeek = new Date(selDateStr + 'T12:00:00').getDay();
    const dayObj = DAYS.find(d => d.id === dayOfWeek);
    document.getElementById('todayDayLabel').textContent = `برنامه ${dayObj ? dayObj.name : ''} (${toPersianDate(selDateStr)})`;

    const activePeopleNames = state.people.map(p => p.name);
    const todaysPlanned = state.schedule.filter(s => s.day_of_week === dayOfWeek && isScheduleValidForActivePeople(s, activePeopleNames));
    const todaysConfirmed = state.trips.filter(t => t.trip_date === selDateStr);

    const remainingCount = todaysPlanned.filter(item =>
      !todaysConfirmed.some(t => t.person === item.person && t.trip_type.startsWith(item.title))
    ).length;
    document.getElementById('confirmAllBtn').classList.toggle('hidden', remainingCount < 2);

    const checklistEl = document.getElementById('todayChecklist');
    if (todaysPlanned.length === 0) {
      checklistEl.innerHTML = `<div style="color:var(--muted); font-size:0.84rem; padding:8px 0;">
        برای ${dayObj ? dayObj.name : 'امروز'} برنامه‌ای ثبت نشده. از منوی پایین وارد <strong>«برنامه هفته»</strong> شوید.
      </div>`;
    } else {
      checklistEl.innerHTML = todaysPlanned.map(item => {
        const isGroup = item.person.includes(' و ');
        const matched = todaysConfirmed.find(t => t.person === item.person && t.trip_type.startsWith(item.title));
        if (matched) {
          const wasAbsent = matched.trip_type.includes('(نرفتم)');
          return `
            <div class="today-item ${wasAbsent ? 'absent' : 'done'}">
              <div class="today-top">
                <div>
                  <span class="green-dot" title="وضعیت ثبت شد"></span>
                  <strong>${isGroup ? '👥' : '👤'} ${item.person} — ${item.title}</strong>
                  <div style="font-size:0.8rem; color:${wasAbsent ? 'var(--danger)' : 'var(--success)'}; margin-top:4px; padding-right:18px;">
                    ${wasAbsent ? '❌ ثبت شده: نرفتم (۰ تومان)' : `✅ تایید شد (${formatMoney(matched.amount)})`}
                  </div>
                </div>
              </div>
              <button class="btn-status-badge" onclick="unconfirmTrip(${matched.id})">تغییر وضعیت / لغو</button>
            </div>
          `;
        } else {
          return `
            <div class="today-item">
              <div class="today-top">
                <strong>${isGroup ? '👥' : '👤'} ${item.person} — ${item.title}</strong>
                <span style="color:var(--primary); font-weight:700; font-size:0.88rem;">${formatMoney(item.price)}</span>
              </div>
              <div class="today-actions">
                <button class="btn-confirm" onclick='recordTodayStatus(${JSON.stringify(item)}, true)'>✅ رفتم (تایید)</button>
                <button class="btn-absent" onclick='recordTodayStatus(${JSON.stringify(item)}, false)'>❌ نرفتم</button>
              </div>
            </div>
          `;
        }
      }).join('');
    }

    // 2. رندر تب «برنامه هفته» + پوشه افراد + پوشه کلاس‌های دوتایی/مشترک
    document.getElementById('dayPills').innerHTML = DAYS.map(d => {
      const isSelected = state.selectedSchedDays.includes(d.id);
      return `<button type="button" class="pill-btn ${isSelected ? 'active' : ''}" onclick="toggleMultiSelect(state.selectedSchedDays, ${d.id})">${isSelected ? '✓ ' : ''}${d.name}</button>`;
    }).join('');

    const dayOrder = [6, 0, 1, 2, 3, 4, 5];
    const renderFolderItems = (items) => {
      if (items.length === 0) return '<div style="color:var(--muted); font-size:0.8rem; padding-top:8px;">هنوز برنامه‌ای در این پوشه ثبت نشده است.</div>';
      const sorted = [...items].sort((a, b) => dayOrder.indexOf(a.day_of_week) - dayOrder.indexOf(b.day_of_week));
      return sorted.map(s => {
        const dName = DAYS.find(d => d.id === s.day_of_week)?.name || '';
        const isGroup = s.person.includes(' و ');
        return `
          <div class="log-item">
            <div>
              <span style="background:rgba(234,179,8,0.16); color:var(--primary); padding:2px 7px; border-radius:6px; font-size:0.74rem; margin-left:6px;">${dName}</span>
              <span>${s.title}</span>
              ${isGroup ? `<span style="font-size:0.75rem; color:var(--muted);"> (${s.person})</span>` : ''}
              <div style="font-size:0.78rem; color:var(--primary); margin-top:2px;">${formatMoney(s.price)}</div>
            </div>
            <button class="del-btn" onclick="deleteScheduleItem(${s.id})">حذف</button>
          </div>
        `;
      }).join('');
    };

    // پوشه اختصاصی کلاس‌های دوتایی و مشترک
    const groupItems = state.schedule.filter(s => s.person.includes(' و ') && isScheduleValidForActivePeople(s, activePeopleNames));
    const isGroupOpen = !!state.openFolders['__GROUP__'];
    const groupFolderHtml = `
      <div class="folder-card" style="border-color: rgba(234, 179, 8, 0.35);">
        <div class="folder-header" onclick="toggleFolder('__GROUP__')">
          <span>👥 پوشه <strong>کلاس‌های دوتایی و مشترک</strong> (${groupItems.length} مورد)</span>
          <span>${isGroupOpen ? '▲' : '▼'}</span>
        </div>
        ${isGroupOpen ? `<div class="folder-body">${renderFolderItems(groupItems)}</div>` : ''}
      </div>
    `;

    // پوشه‌های انفرادی هر فرد
    const individualFoldersHtml = state.people.map(p => {
      const personItems = state.schedule.filter(s => s.person === p.name);
      const isOpen = !!state.openFolders[p.name];
      return `
        <div class="folder-card">
          <div class="folder-header" onclick="toggleFolder('${p.name}')">
            <span>📁 پوشه کلاس‌های <strong>${p.name}</strong> (${personItems.length} مورد)</span>
            <span>${isOpen ? '▲' : '▼'}</span>
          </div>
          ${isOpen ? `<div class="folder-body">${renderFolderItems(personItems)}</div>` : ''}
        </div>
      `;
    }).join('');

    document.getElementById('personFolders').innerHTML = groupFolderHtml + individualFoldersHtml;

    // 3. رندر تب «گزارش مالی»
    const lastSettleIndex = state.trips.findIndex(t => t.person === 'سیستم' && t.trip_type.includes('تسویه حساب'));
    const periodTrips = lastSettleIndex === -1 ? state.trips : state.trips.slice(0, lastSettleIndex);

    const monthAgo = new Date();
    monthAgo.setDate(monthAgo.getDate() - 30);

    let unsettledSum = 0, monthSum = 0;
    const statsPerGroup = {};
    state.people.forEach(p => {
      statsPerGroup[p.name] = { amount: 0, presentCount: 0, absentCount: 0 };
    });

    periodTrips.forEach(t => {
      if (t.person === 'سیستم') return;
      const isItemSettled = t.trip_type.includes('[تسویه شده]');
      const amt = isItemSettled ? 0 : Number(t.amount);
      unsettledSum += amt;

      if (!statsPerGroup[t.person]) statsPerGroup[t.person] = { amount: 0, presentCount: 0, absentCount: 0 };
      statsPerGroup[t.person].amount += amt;
      if (t.trip_type.includes('(نرفتم)')) statsPerGroup[t.person].absentCount++;
      else statsPerGroup[t.person].presentCount++;
    });

    state.trips.forEach(t => {
      if (t.person === 'سیستم') return;
      if (new Date(t.trip_date) >= monthAgo) monthSum += Number(t.amount);
    });

    document.getElementById('unsettledTotal').textContent = formatMoney(unsettledSum);
    document.getElementById('monthTotal').textContent = formatMoney(monthSum);

    document.getElementById('personBreakdown').innerHTML = Object.keys(statsPerGroup)
      .filter(k => statsPerGroup[k].presentCount > 0 || statsPerGroup[k].absentCount > 0 || activePeopleNames.includes(k))
      .map(name => {
        const st = statsPerGroup[name];
        const isGroup = name.includes(' و ');
        return `
          <div class="today-item" style="margin-bottom:8px;">
            <div class="today-top">
              <div>
                <strong>${isGroup ? '👥' : '👤'} ${name}</strong>
                <div style="font-size:0.78rem; color:var(--muted); margin-top:3px;">
                  ✅ ${st.presentCount} سرویس رفت &nbsp;|&nbsp; ❌ ${st.absentCount} غیبت
                </div>
              </div>
              <div style="color:var(--primary); font-weight:700; font-size:0.95rem;">${formatMoney(st.amount)}</div>
            </div>
          </div>
        `;
      }).join('');

    const filterSel = document.getElementById('filterPerson');
    const curFilter = filterSel.value;
    const allTripOwners = [...new Set([...activePeopleNames, ...state.trips.filter(t => t.person !== 'سیستم').map(t => t.person)])];
    filterSel.innerHTML = `<option value="ALL">همه موارد</option>` +
      allTripOwners.map(name => `<option value="${name}" ${curFilter === name ? 'selected' : ''}>${name}</option>`).join('');

    const filtered = curFilter === 'ALL' ? state.trips : state.trips.filter(t => t.person === curFilter);
    document.getElementById('fullLogs').innerHTML = filtered.map((t, idx) => {
      if (t.person === 'سیستم') {
        return `<div class="log-item" style="justify-content:center; color:var(--success); font-weight:700;">${t.trip_type} (${toPersianDate(t.trip_date)})</div>`;
      }
      const isGlobalSettled = lastSettleIndex !== -1 && idx > lastSettleIndex;
      const isSingleSettled = t.trip_type.includes('[تسویه شده]');
      const isSettled = isGlobalSettled || isSingleSettled;
      const cleanTitle = t.trip_type.replace(' [تسویه شده]', '');

      return `
        <div class="log-item">
          <div>
            <strong>${t.person}</strong> — ${cleanTitle}
            <div style="font-size:0.75rem; color:var(--muted);">${toPersianDate(t.trip_date)}</div>
          </div>
          <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap; justify-content:flex-end;">
            <span style="color:${isSettled ? 'var(--muted)' : 'var(--primary)'}; text-decoration:${isSettled ? 'line-through' : 'none'};">${formatMoney(t.amount)}</span>
            ${isSettled
              ? `<span class="settled-tag">✓ تسویه شده</span>`
              : (Number(t.amount) > 0 ? `<button class="btn-settle-item" onclick='settleSingleTrip(${JSON.stringify(t)})'>تسویه شد</button>` : '')
            }
            <button class="del-btn" onclick="deleteTripRecord(${t.id})">حذف</button>
          </div>
        </div>
      `;
    }).join('') || '<div style="color:var(--muted);">هنوز ترددی ثبت نشده است.</div>';

    // 4. رندر تب «تنظیمات» (مدیریت افراد)
    document.getElementById('peopleManageList').innerHTML = state.people.map(p => `
      <div class="log-item">
        <span>👤 ${p.name}</span>
        <button class="del-btn" onclick="deletePerson(${p.id}, '${p.name}')">حذف</button>
      </div>
    `).join('');
  }

  function copyReport() {
    let text = `📊 صورت‌حساب سرویس مدرسه\n`;
    text += `• جمع بدهی قابل پرداخت: ${document.getElementById('unsettledTotal').textContent}\n\n`;
    document.querySelectorAll('#personBreakdown .today-item').forEach(el => {
      text += `- ${el.innerText.replace(/\n+/g, ' | ')}\n`;
    });
    const ta = document.createElement('textarea');
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    showToast('📋 صورت‌حساب کپی شد!');
  }

  loadData();
</script>
</body>
</html>
